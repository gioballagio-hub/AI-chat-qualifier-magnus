generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id                String   @id @default(cuid())
  clienteType       String   @default("INDEFINITO") // "AZIENDA" | "PRIVATO" | "INDEFINITO"
  data              Json
  score             String   // "ALTA" | "MEDIA" | "BASSA"
  completeness      Float
  missingFields     Json     // string[]
  status            String   @default("NEW") // "NEW" | "CONTACTED" | "ARCHIVED"
  consentGiven      Boolean  @default(false)
  ipHash            String?
  nextStep          String
  sentToIntegration Boolean  @default(false)
  // Dati contatto
  nome              String?
  cognome           String?
  eta               Int?     // mantenuto per retrocompatibilità, non più usato nel form
  emailContatto     String?
  telefono          String?
  emailInviata      Boolean  @default(false)
  // Campi Magnus estratti per ricerca rapida in dashboard
  ragioneSociale    String?
  partitaIVA        String?
  categoriaProdotto String?  // "Accessori" | "Ricambi" | "Lubrificanti" | "Vernici"
  brandProdotto     String?
  codiceProdotto    String?
  vinCode           String?
  commercialeAssegnato String? // nome o ID del commerciale assegnato
  statoLead         String   @default("NUOVO") // pipeline: NUOVO | IN_LAVORAZIONE | OFFERTA_INVIATA | CHIUSO_VINTO | CHIUSO_PERSO
  deletedAt         DateTime? // soft delete — null = attivo, valorizzato = eliminato
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
  @@index([score])
  @@index([status])
  @@index([deletedAt, createdAt(sort: Desc)])
}

model Nota {
  id        String   @id @default(cuid())
  leadId    String
  autore    String
  testo     String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Settings {
  id              Int     @id @default(1)
  integrationMode String  @default("WEBHOOK")
  webhookUrl      String?
  webhookSecret   String?
  notificheEmailCommerciale Boolean @default(true) // invia email al commerciale quando viene assegnato
  reminderAbilitato         Boolean @default(false) // invia reminder per lead non lavorati
  reminderGiorni            Int     @default(3)     // giorni di inattività prima del reminder
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  autore    String
  azione    String   // es: "COMMERCIALE_ASSEGNATO", "PIPELINE_AGGIORNATO", "NOTA_AGGIUNTA", "LEAD_ELIMINATO", "LEAD_RIPRISTINATO"
  dettagli  String?  // JSON stringificato con dati aggiuntivi (es. da/a)
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt(sort: Desc)])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nome         String
  passwordHash String
  ruolo        String   @default("COMMERCIALE") // "ADMIN" | "COMMERCIALE"
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WaMessage {
  id            String   @id @default(cuid())
  phone         String
  text          String
  phoneNumberId String
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([phone, processed])
  @@index([createdAt])
}

model WaConversation {
  id                     String   @id @default(cuid())
  phone                  String   @unique
  messages               Json     @default("[]")
  raccolto               Json     @default("{}")
  completato             Boolean  @default(false)
  chatwootConversationId Int?     // ID conversazione Chatwoot per invio messaggi dal pannello admin
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([phone])
}
