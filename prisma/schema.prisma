generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id                String   @id @default(cuid())
  clienteType       String   @default("INDEFINITO") // "AZIENDA" | "PRIVATO" | "INDEFINITO"
  data              Json
  score             String   // "ALTA" | "MEDIA" | "BASSA"
  completeness      Float
  missingFields     Json     // string[]
  status            String   @default("NEW") // "NEW" | "CONTACTED" | "ARCHIVED"
  consentGiven      Boolean  @default(false)
  ipHash            String?
  nextStep          String
  sentToIntegration Boolean  @default(false)
  // Dati contatto
  nome              String?
  cognome           String?
  eta               Int?     // mantenuto per retrocompatibilità, non più usato nel form
  emailContatto     String?
  telefono          String?
  emailInviata      Boolean  @default(false)
  // Campi Magnus estratti per ricerca rapida in dashboard
  ragioneSociale    String?
  partitaIVA        String?
  categoriaProdotto String?  // "Accessori" | "Ricambi" | "Lubrificanti" | "Vernici"
  brandProdotto     String?
  codiceProdotto    String?
  vinCode           String?
  commercialeAssegnato String? // nome o ID del commerciale assegnato
  statoLead         String   @default("NUOVO") // pipeline: NUOVO | IN_LAVORAZIONE | OFFERTA_INVIATA | CHIUSO_VINTO | CHIUSO_PERSO
  deletedAt         DateTime? // soft delete — null = attivo, valorizzato = eliminato
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Settings {
  id              Int     @id @default(1)
  integrationMode String  @default("WEBHOOK")
  webhookUrl      String?
  webhookSecret   String?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nome         String
  passwordHash String
  ruolo        String   @default("COMMERCIALE") // "ADMIN" | "COMMERCIALE"
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
